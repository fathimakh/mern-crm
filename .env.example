# Copy this file to .env and fill in your own values:  cp .env.example .env

# ---------- Server (Express API) ----------
PORT=5014
# NODE_ENV is intentionally not set here: Vite also reads this file and would
# then build a development bundle. Set NODE_ENV=production in the server's
# real environment when deploying.

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/mern_crm
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Origin of the React app (used for CORS)
CLIENT_URL=http://localhost:5174

# ---------- Client (Vite only exposes VITE_* variables to the browser) ----------
VITE_API_URL=http://localhost:5014/api
